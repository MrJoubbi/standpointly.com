# =================================================================
# Standpointly — Production Environment Configuration
# =================================================================

# Canonical Base URL (Used for sitemaps, OpenGraph image absolute links, metadata)
# Replace with your actual domain
SITE_URL="https://standpointly.com"

# Port (Next.js server port, defaults to 3000)
PORT=3000

# Node Environment
NODE_ENV="production"

# Optional Cloudflare Tunnel Token (If using Docker Compose cloudflared service)
# Obtain this token from Cloudflare Zero Trust Dashboard -> Networks -> Tunnels
CLOUDFLARE_TUNNEL_TOKEN=""

# Gemini API Key (Optional / server-side AI features if enabled)
GEMINI_API_KEY=""

# Google Analytics 4 Measurement ID (e.g., G-XXXXXXXXXX)
NEXT_PUBLIC_GA_MEASUREMENT_ID=""

# Google Search Console Verification Meta Tag content
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""
